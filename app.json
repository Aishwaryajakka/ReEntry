{
  "expo": {
    "name": "ReEntry",
    "slug": "reentry-app",
    "scheme": "appe1ekxea1zf29",
    "version": "1.0.30",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.miaoda.appe1ekxea1zf29",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow ReEntry to transcribe your activity description so you can review it before logging.",
        "NSMicrophoneUsageDescription": "Allow ReEntry to use the microphone for voice-assisted activity logging."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8E3D9"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.miaoda.appe1ekxea1zf29",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-sqlite",
      "expo-font",
      "expo-system-ui",
      "expo-image",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ReEntry to use the microphone for voice-assisted activity logging.",
          "speechRecognitionPermission": "Allow ReEntry to transcribe your activity description so you can review it before logging.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e1ae0bb3-49b0-4a48-b299-ebec1d122bd0"
      }
    }
  }
}
